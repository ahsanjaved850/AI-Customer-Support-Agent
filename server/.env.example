# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Admin auth for the Setup tab (provider/API key, branding, documents).
# Leave unset for local dev — the Setup tab stays open with no login.
# REQUIRED before exposing this server beyond localhost: set a strong
# password here, restart the server, and the Setup tab will require it.
# ADMIN_PASSWORD=change-me

# Set to "production" in a real deployment so the admin session cookie is
# marked Secure (HTTPS-only). Leave unset for local http:// dev.
# NODE_ENV=production

# Set to "1" only if this server actually sits behind a reverse proxy
# (nginx, Caddy, a platform load balancer). Makes rate limiting key on the
# real client IP instead of the proxy's. Leave unset otherwise — enabling
# it with no proxy in front lets clients spoof their IP and dodge limits.
# TRUST_PROXY=1

# Requests to /api/chat per IP per minute before a 429. Default: 20.
# CHAT_RATE_LIMIT_MAX=20

# LLM provider (used by src/lib/agent.ts)
# ANTHROPIC_API_KEY=your-key-here
# MODEL=claude-sonnet-5
